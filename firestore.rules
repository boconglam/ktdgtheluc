rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Pillar 4.1: Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // GLOBAL PRIMITIVES & IDENTITY HELPERS
    // =========================================================================
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrapSuperAdmin() {
      return isVerified() && request.auth.token.email.lower() == 'boconglam@gmail.com';
    }

    function userDocPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasActiveUserDoc() {
      return exists(userDocPath(request.auth.uid))
        && get(userDocPath(request.auth.uid)).data.status == 'active';
    }

    function isSuperAdmin() {
      return isBootstrapSuperAdmin() || (
        isVerified()
        && hasActiveUserDoc()
        && get(userDocPath(request.auth.uid)).data.role == 'super_admin'
      );
    }

    function isAdminOrSuper() {
      return isBootstrapSuperAdmin() || (
        isVerified()
        && hasActiveUserDoc()
        && get(userDocPath(request.auth.uid)).data.role in ['super_admin', 'admin']
      );
    }

    function isCloudSyncAuthorized() {
      return isBootstrapSuperAdmin() || (
        isVerified()
        && hasActiveUserDoc()
        && get(userDocPath(request.auth.uid)).data.canCloudSync == true
      );
    }

    function isValidUidArray(arr) {
      return arr is list
        && arr.size() >= 1
        && arr.size() <= 30
        && arr[0] is string
        && arr[0].size() >= 1
        && arr[0].size() <= 128;
    }

    function isValidClassArray(arr) {
      return arr is list
        && arr.size() >= 1
        && arr.size() <= 30
        && arr[0] is string
        && arr[0].size() >= 1
        && arr[0].size() <= 30;
    }

    // =========================================================================
    // ENTITY VALIDATION BLUEPRINTS (Pillar 2)
    // =========================================================================
    function isValidUserAccount(data) {
      return data.keys().hasAll([
        'uid', 'email', 'displayName', 'role', 'canCloudSync',
        'canViewStudents', 'canEditStudents', 'canRecordTests', 'canExportPdf',
        'assignedClasses', 'status', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'uid', 'email', 'displayName', 'role', 'canCloudSync',
        'canViewStudents', 'canEditStudents', 'canRecordTests', 'canExportPdf',
        'assignedClasses', 'status', 'inviteId', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.uid)
      && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
      && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
      && data.role in ['super_admin', 'admin', 'staff']
      && data.canCloudSync is bool
      && data.canViewStudents is bool
      && data.canEditStudents is bool
      && data.canRecordTests is bool
      && data.canExportPdf is bool
      && isValidClassArray(data.assignedClasses)
      && data.status in ['active', 'disabled']
      && (!('inviteId' in data) || (data.inviteId is string && data.inviteId.size() <= 128))
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidUserInvite(data) {
      return data.keys().hasAll([
        'id', 'email', 'displayName', 'role', 'canCloudSync',
        'canViewStudents', 'canEditStudents', 'canRecordTests', 'canExportPdf',
        'assignedClasses', 'status', 'createdByUid', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'email', 'displayName', 'role', 'canCloudSync',
        'canViewStudents', 'canEditStudents', 'canRecordTests', 'canExportPdf',
        'assignedClasses', 'status', 'createdByUid', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.id)
      && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
      && data.email != 'boconglam@gmail.com'
      && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
      && data.role in ['admin', 'staff']
      && data.canCloudSync is bool
      && data.canViewStudents is bool
      && data.canEditStudents is bool
      && data.canRecordTests is bool
      && data.canExportPdf is bool
      && isValidClassArray(data.assignedClasses)
      && data.status in ['active', 'disabled']
      && isValidId(data.createdByUid)
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function matchesUserInvite(data, inviteId) {
      return inviteId is string
        && isValidId(inviteId)
        && exists(/databases/$(database)/documents/user_invites/$(inviteId))
        && get(/databases/$(database)/documents/user_invites/$(inviteId)).data.email == request.auth.token.email.lower()
        && get(/databases/$(database)/documents/user_invites/$(inviteId)).data.role == data.role
        && get(/databases/$(database)/documents/user_invites/$(inviteId)).data.canCloudSync == data.canCloudSync
        && get(/databases/$(database)/documents/user_invites/$(inviteId)).data.canViewStudents == data.canViewStudents
        && get(/databases/$(database)/documents/user_invites/$(inviteId)).data.canEditStudents == data.canEditStudents
        && get(/databases/$(database)/documents/user_invites/$(inviteId)).data.canRecordTests == data.canRecordTests
        && get(/databases/$(database)/documents/user_invites/$(inviteId)).data.canExportPdf == data.canExportPdf
        && get(/databases/$(database)/documents/user_invites/$(inviteId)).data.assignedClasses == data.assignedClasses
        && get(/databases/$(database)/documents/user_invites/$(inviteId)).data.status == data.status;
    }

    function isValidSchoolConfig(data) {
      return data.keys().hasAll([
        'id', 'managingAuthority', 'schoolName', 'schoolYear', 'locationName',
        'documentCode', 'signerTitle', 'signerName', 'preparerName',
        'ownerUid', 'authorizedUids', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'managingAuthority', 'schoolName', 'schoolYear', 'locationName',
        'documentCode', 'signerTitle', 'signerName', 'preparerName',
        'ownerUid', 'authorizedUids', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.id)
      && data.managingAuthority is string && data.managingAuthority.size() <= 200
      && data.schoolName is string && data.schoolName.size() <= 200
      && data.schoolYear is string && data.schoolYear.size() <= 40
      && data.locationName is string && data.locationName.size() <= 80
      && data.documentCode is string && data.documentCode.size() <= 60
      && data.signerTitle is string && data.signerTitle.size() <= 100
      && data.signerName is string && data.signerName.size() <= 120
      && data.preparerName is string && data.preparerName.size() <= 120
      && isValidId(data.ownerUid)
      && isValidUidArray(data.authorizedUids)
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidStudent(data) {
      return data.keys().hasAll([
        'id', 'schoolId', 'studentCode', 'fullName', 'className',
        'gradeLevel', 'gender', 'birthYear', 'age', 'notes',
        'ownerUid', 'authorizedUids', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'schoolId', 'studentCode', 'fullName', 'className',
        'gradeLevel', 'gender', 'birthYear', 'age', 'notes',
        'ownerUid', 'authorizedUids', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.id)
      && isValidId(data.schoolId)
      && data.studentCode is string && data.studentCode.size() <= 40
      && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 120
      && data.className is string && data.className.size() >= 1 && data.className.size() <= 30
      && data.gradeLevel is int && data.gradeLevel >= 10 && data.gradeLevel <= 12
      && data.gender in ['nam', 'nu']
      && data.birthYear is int && data.birthYear >= 1995 && data.birthYear <= 2020
      && data.age is int && data.age >= 14 && data.age <= 20
      && data.notes is string && data.notes.size() <= 500
      && isValidId(data.ownerUid)
      && isValidUidArray(data.authorizedUids)
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidAssessment(data) {
      return data.keys().hasAll([
        'id', 'studentId', 'schoolId', 'termLabel', 'schoolYear', 'testedAt',
        'ageAtTest', 'gender', 'heightCm', 'weightKg', 'bmi', 'bmiCategory',
        'situpsCount', 'situpsGrade', 'longJumpCm', 'longJumpGrade',
        'enduranceMode', 'enduranceValue', 'enduranceGrade',
        'overallGrade', 'captureMethod', 'status', 'recordedByUid',
        'authorizedUids', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'id', 'studentId', 'schoolId', 'termLabel', 'schoolYear', 'testedAt',
        'ageAtTest', 'gender', 'heightCm', 'weightKg', 'bmi', 'bmiCategory',
        'situpsCount', 'situpsGrade', 'longJumpCm', 'longJumpGrade',
        'enduranceMode', 'enduranceValue', 'enduranceGrade',
        'overallGrade', 'captureMethod', 'status', 'recordedByUid',
        'authorizedUids', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.id)
      && isValidId(data.studentId)
      && isValidId(data.schoolId)
      && data.termLabel is string && data.termLabel.size() >= 1 && data.termLabel.size() <= 80
      && data.schoolYear is string && data.schoolYear.size() >= 1 && data.schoolYear.size() <= 40
      && data.testedAt is string && data.testedAt.size() >= 4 && data.testedAt.size() <= 40
      && data.ageAtTest is int && data.ageAtTest >= 14 && data.ageAtTest <= 20
      && data.gender in ['nam', 'nu']
      && data.heightCm is number && data.heightCm >= 100 && data.heightCm <= 230
      && data.weightKg is number && data.weightKg >= 20 && data.weightKg <= 180
      && data.bmi is number && data.bmi >= 8 && data.bmi <= 60
      && data.bmiCategory is string && data.bmiCategory.size() >= 1 && data.bmiCategory.size() <= 40
      && data.situpsCount is int && data.situpsCount >= 0 && data.situpsCount <= 120
      && data.situpsGrade in ['tot', 'dat', 'chua_dat']
      && data.longJumpCm is number && data.longJumpCm >= 0 && data.longJumpCm <= 450
      && data.longJumpGrade in ['tot', 'dat', 'chua_dat']
      && data.enduranceMode in ['5min_m', 'distance_s']
      && data.enduranceValue is number && data.enduranceValue >= 0 && data.enduranceValue <= 5000
      && data.enduranceGrade in ['tot', 'dat', 'chua_dat']
      && data.overallGrade in ['tot', 'dat', 'chua_dat']
      && data.captureMethod in ['camera_ai', 'manual']
      && data.status in ['draft', 'finalized']
      && isValidId(data.recordedByUid)
      && isValidUidArray(data.authorizedUids)
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    // =========================================================================
    // HEALTHCHECK CONNECTION DOC
    // =========================================================================
    match /test/connection {
      allow get: if isSignedIn();
    }

    // =========================================================================
    // USERS & RBAC COLLECTION
    // =========================================================================
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isSuperAdmin());
      allow list: if isSignedIn() && (isBootstrapSuperAdmin() || existing().uid == request.auth.uid);

      allow create: if isVerified()
        && isValidId(userId)
        && isValidUserAccount(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (isBootstrapSuperAdmin() && incoming().uid == request.auth.uid && incoming().role == 'super_admin' && incoming().canCloudSync == true && incoming().status == 'active') ||
          (isSuperAdmin() && incoming().email != 'boconglam@gmail.com') ||
          (isOwner(userId)
            && incoming().uid == request.auth.uid
            && incoming().email == request.auth.token.email
            && 'inviteId' in incoming()
            && matchesUserInvite(incoming(), incoming().inviteId)) ||
          (isOwner(userId)
            && incoming().uid == request.auth.uid
            && incoming().email == request.auth.token.email
            && incoming().role == 'staff'
            && incoming().canCloudSync == false
            && incoming().canViewStudents == true
            && incoming().canEditStudents == false
            && incoming().canRecordTests == true
            && incoming().canExportPdf == true
            && incoming().status == 'active')
        );

      allow update: if isVerified()
        && isValidId(userId)
        && isValidUserAccount(incoming())
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          existing().email.lower() != 'boconglam@gmail.com' || (
            incoming().role == 'super_admin'
            && incoming().canCloudSync == true
            && incoming().canViewStudents == true
            && incoming().canEditStudents == true
            && incoming().canRecordTests == true
            && incoming().canExportPdf == true
            && incoming().status == 'active'
          )
        )
        && (
          (isSuperAdmin() && incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName', 'role', 'canCloudSync', 'canViewStudents',
            'canEditStudents', 'canRecordTests', 'canExportPdf',
            'assignedClasses', 'status', 'updatedAt'
          ])) ||
          (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']))
        );

      allow delete: if isValidId(userId)
        && isSuperAdmin()
        && userId != request.auth.uid
        && existing().email.lower() != 'boconglam@gmail.com';
    }

    // =========================================================================
    // USER INVITES (PRE-PROVISIONED RBAC PERMISSIONS BY EMAIL)
    // =========================================================================
    match /user_invites/{inviteId} {
      allow get: if isVerified() && isValidId(inviteId)
        && (isSuperAdmin() || existing().email == request.auth.token.email.lower());

      allow list: if isVerified()
        && (isBootstrapSuperAdmin() || existing().email == request.auth.token.email.lower());

      allow create: if isVerified()
        && isValidId(inviteId)
        && isValidUserInvite(incoming())
        && incoming().id == inviteId
        && incoming().createdByUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isSuperAdmin();

      allow update: if isVerified()
        && isValidId(inviteId)
        && isValidUserInvite(incoming())
        && incoming().id == existing().id
        && incoming().createdByUid == existing().createdByUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && isSuperAdmin()
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'email', 'displayName', 'role', 'canCloudSync', 'canViewStudents',
          'canEditStudents', 'canRecordTests', 'canExportPdf',
          'assignedClasses', 'status', 'updatedAt'
        ]);

      allow delete: if isVerified()
        && isValidId(inviteId)
        && isSuperAdmin()
        && existing().email != 'boconglam@gmail.com';
    }

    // =========================================================================
    // SCHOOL ADMINISTRATIVE CONFIG COLLECTION
    // =========================================================================
    match /schools/{schoolId} {
      allow get: if isVerified() && isValidId(schoolId)
        && (isBootstrapSuperAdmin() || request.auth.uid in existing().authorizedUids || existing().ownerUid == request.auth.uid);

      allow list: if isVerified()
        && (isBootstrapSuperAdmin() || request.auth.uid in existing().authorizedUids || existing().ownerUid == request.auth.uid);

      allow create: if isVerified()
        && isValidId(schoolId)
        && isValidSchoolConfig(incoming())
        && incoming().id == schoolId
        && incoming().ownerUid == request.auth.uid
        && request.auth.uid in incoming().authorizedUids
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isCloudSyncAuthorized();

      allow update: if isVerified()
        && isValidId(schoolId)
        && isValidSchoolConfig(incoming())
        && incoming().id == existing().id
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && isCloudSyncAuthorized()
        && (
          (isSuperAdmin() && incoming().diff(existing()).affectedKeys().hasOnly([
            'managingAuthority', 'schoolName', 'schoolYear', 'locationName',
            'documentCode', 'signerTitle', 'signerName', 'preparerName',
            'authorizedUids', 'updatedAt'
          ])) ||
          (isAdminOrSuper() && request.auth.uid in existing().authorizedUids && incoming().diff(existing()).affectedKeys().hasOnly([
            'managingAuthority', 'schoolName', 'schoolYear', 'locationName',
            'documentCode', 'signerTitle', 'signerName', 'preparerName', 'updatedAt'
          ]))
        );

      allow delete: if isVerified() && isValidId(schoolId) && isSuperAdmin();
    }

    // =========================================================================
    // STUDENTS COLLECTION
    // =========================================================================
    match /students/{studentId} {
      allow get: if isVerified() && isValidId(studentId)
        && (isBootstrapSuperAdmin() || request.auth.uid in existing().authorizedUids || existing().ownerUid == request.auth.uid);

      allow list: if isVerified()
        && (isBootstrapSuperAdmin() || request.auth.uid in existing().authorizedUids || existing().ownerUid == request.auth.uid);

      allow create: if isVerified()
        && isValidId(studentId)
        && isValidStudent(incoming())
        && incoming().id == studentId
        && incoming().ownerUid == request.auth.uid
        && request.auth.uid in incoming().authorizedUids
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isCloudSyncAuthorized()
        && exists(/databases/$(database)/documents/schools/$(incoming().schoolId));

      allow update: if isVerified()
        && isValidId(studentId)
        && isValidStudent(incoming())
        && incoming().id == existing().id
        && incoming().schoolId == existing().schoolId
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && isCloudSyncAuthorized()
        && (
          (isSuperAdmin() && incoming().diff(existing()).affectedKeys().hasOnly([
            'studentCode', 'fullName', 'className', 'gradeLevel',
            'gender', 'birthYear', 'age', 'notes', 'authorizedUids', 'updatedAt'
          ])) ||
          (request.auth.uid in existing().authorizedUids && incoming().diff(existing()).affectedKeys().hasOnly([
            'studentCode', 'fullName', 'className', 'gradeLevel',
            'gender', 'birthYear', 'age', 'notes', 'updatedAt'
          ]))
        );

      allow delete: if isVerified()
        && isValidId(studentId)
        && isCloudSyncAuthorized()
        && (isSuperAdmin() || existing().ownerUid == request.auth.uid);
    }

    // =========================================================================
    // FITNESS ASSESSMENTS COLLECTION
    // =========================================================================
    match /assessments/{assessmentId} {
      allow get: if isVerified() && isValidId(assessmentId)
        && (isBootstrapSuperAdmin() || request.auth.uid in existing().authorizedUids || existing().recordedByUid == request.auth.uid);

      allow list: if isVerified()
        && (isBootstrapSuperAdmin() || request.auth.uid in existing().authorizedUids || existing().recordedByUid == request.auth.uid);

      allow create: if isVerified()
        && isValidId(assessmentId)
        && isValidAssessment(incoming())
        && incoming().id == assessmentId
        && incoming().recordedByUid == request.auth.uid
        && request.auth.uid in incoming().authorizedUids
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isCloudSyncAuthorized()
        && exists(/databases/$(database)/documents/students/$(incoming().studentId))
        && exists(/databases/$(database)/documents/schools/$(incoming().schoolId));

      allow update: if isVerified()
        && isValidId(assessmentId)
        && isValidAssessment(incoming())
        && incoming().id == existing().id
        && incoming().studentId == existing().studentId
        && incoming().schoolId == existing().schoolId
        && incoming().recordedByUid == existing().recordedByUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && isCloudSyncAuthorized()
        && (
          (isAdminOrSuper() && (isSuperAdmin() || request.auth.uid in existing().authorizedUids) && incoming().diff(existing()).affectedKeys().hasOnly([
            'termLabel', 'schoolYear', 'testedAt', 'ageAtTest', 'gender',
            'heightCm', 'weightKg', 'bmi', 'bmiCategory',
            'situpsCount', 'situpsGrade', 'longJumpCm', 'longJumpGrade',
            'enduranceMode', 'enduranceValue', 'enduranceGrade',
            'overallGrade', 'captureMethod', 'status', 'authorizedUids', 'updatedAt'
          ])) ||
          (existing().status != 'finalized' && request.auth.uid in existing().authorizedUids && incoming().diff(existing()).affectedKeys().hasOnly([
            'termLabel', 'schoolYear', 'testedAt', 'ageAtTest', 'gender',
            'heightCm', 'weightKg', 'bmi', 'bmiCategory',
            'situpsCount', 'situpsGrade', 'longJumpCm', 'longJumpGrade',
            'enduranceMode', 'enduranceValue', 'enduranceGrade',
            'overallGrade', 'captureMethod', 'status', 'updatedAt'
          ]))
        );

      allow delete: if isVerified()
        && isValidId(assessmentId)
        && isCloudSyncAuthorized()
        && (isSuperAdmin() || (existing().status != 'finalized' && existing().recordedByUid == request.auth.uid));
    }
  }
}
