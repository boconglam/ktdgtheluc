{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Tài khoản người dùng và phân quyền truy cập (Super Admin, Admin, Nhân viên) cùng quyền đồng bộ đám mây.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID của người dùng",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Địa chỉ email xác thực",
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "description": "Họ và tên hiển thị",
          "minLength": 1,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["super_admin", "admin", "staff"],
          "description": "Vai trò phân quyền trong hệ thống"
        },
        "canCloudSync": {
          "type": "boolean",
          "description": "Quyền được phép đồng bộ dữ liệu lên đám mây do Super Admin cấp"
        },
        "canViewStudents": {
          "type": "boolean",
          "description": "Quyền xem danh sách và tiến trình học sinh"
        },
        "canEditStudents": {
          "type": "boolean",
          "description": "Quyền thêm, sửa, nhập Excel danh sách học sinh"
        },
        "canRecordTests": {
          "type": "boolean",
          "description": "Quyền thực hiện kiểm tra và ghi nhận kết quả thể lực"
        },
        "canExportPdf": {
          "type": "boolean",
          "description": "Quyền xuất báo cáo hành chính PDF"
        },
        "assignedClasses": {
          "type": "array",
          "description": "Danh sách lớp được phép truy cập hoặc ['*'] cho toàn trường"
        },
        "status": {
          "type": "string",
          "enum": ["active", "disabled"],
          "description": "Trạng thái hoạt động tài khoản"
        },
        "inviteId": {
          "type": "string",
          "description": "Mã cấp quyền trước nếu được Super Admin thêm trước khi đăng nhập",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Thời điểm tạo tài khoản (server timestamp)"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Thời điểm cập nhật gần nhất (server timestamp)"
        }
      },
      "required": [
        "uid",
        "email",
        "displayName",
        "role",
        "canCloudSync",
        "canViewStudents",
        "canEditStudents",
        "canRecordTests",
        "canExportPdf",
        "assignedClasses",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserInvite": {
      "title": "UserInvite",
      "description": "Bản ghi cấp quyền trước theo email do Super Admin tạo để thêm, sửa, xóa phân quyền người dùng.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["admin", "staff"]
        },
        "canCloudSync": {
          "type": "boolean"
        },
        "canViewStudents": {
          "type": "boolean"
        },
        "canEditStudents": {
          "type": "boolean"
        },
        "canRecordTests": {
          "type": "boolean"
        },
        "canExportPdf": {
          "type": "boolean"
        },
        "assignedClasses": {
          "type": "array"
        },
        "status": {
          "type": "string",
          "enum": ["active", "disabled"]
        },
        "createdByUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "email",
        "displayName",
        "role",
        "canCloudSync",
        "canViewStudents",
        "canEditStudents",
        "canRecordTests",
        "canExportPdf",
        "assignedClasses",
        "status",
        "createdByUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "SchoolAdminConfig": {
      "title": "SchoolAdminConfig",
      "description": "Thông tin hành chính cơ sở chủ quản, cơ sở giáo dục, năm học và người ký duyệt báo cáo.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "managingAuthority": {
          "type": "string",
          "description": "Tên cơ quan chủ quản (nhập thủ công)",
          "maxLength": 200
        },
        "schoolName": {
          "type": "string",
          "description": "Tên cơ sở giáo dục (nhập thủ công)",
          "maxLength": 200
        },
        "schoolYear": {
          "type": "string",
          "description": "Năm học (nhập thủ công)",
          "maxLength": 40
        },
        "locationName": {
          "type": "string",
          "description": "Địa danh ban hành báo cáo",
          "maxLength": 80
        },
        "documentCode": {
          "type": "string",
          "description": "Số ký hiệu văn bản hành chính",
          "maxLength": 60
        },
        "signerTitle": {
          "type": "string",
          "description": "Chức vụ người ký (mặc định THỦ TRƯỞNG ĐƠN VỊ)",
          "maxLength": 100
        },
        "signerName": {
          "type": "string",
          "description": "Họ tên người ký duyệt",
          "maxLength": 120
        },
        "preparerName": {
          "type": "string",
          "description": "Tên người lập báo cáo (nhập thủ công)",
          "maxLength": 120
        },
        "schoolLevel": {
          "type": "string",
          "enum": ["tat_ca", "tieu_hoc", "thcs", "thpt", "dai_hoc"],
          "description": "Cấp học áp dụng theo QĐ 53/2008/QĐ-BGDĐT"
        },
        "bmiPreset": {
          "type": "string",
          "enum": ["vn_wpro", "who_global", "custom"],
          "description": "Bộ chuẩn phân loại BMI (Việt Nam IDI & WPRO, WHO, hoặc tùy chỉnh theo quốc gia)"
        },
        "bmiCountryLabel": {
          "type": "string",
          "description": "Tên quốc gia hoặc chuẩn BMI đang áp dụng",
          "maxLength": 100
        },
        "bmiUnderweightMax": {
          "type": "number",
          "description": "Ngưỡng trên thiếu cân (người trưởng thành)"
        },
        "bmiNormalMax": {
          "type": "number",
          "description": "Ngưỡng trên bình thường (Việt Nam/Châu Á: 22.9)"
        },
        "bmiOverweightMax": {
          "type": "number",
          "description": "Ngưỡng trên thừa cân (Việt Nam/Châu Á: 24.9)"
        },
        "bmiObese1Max": {
          "type": "number",
          "description": "Ngưỡng trên béo phì độ I (Việt Nam/Châu Á: 29.9)"
        },
        "bmiAgeAdjust": {
          "type": "boolean",
          "description": "Bật hiệu chỉnh BMI theo độ tuổi học sinh dưới 18 tuổi"
        },
        "ownerUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorizedUids": {
          "type": "array",
          "description": "Danh sách UID được cấp quyền truy cập và đồng bộ dữ liệu trường"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "managingAuthority",
        "schoolName",
        "schoolYear",
        "locationName",
        "documentCode",
        "signerTitle",
        "signerName",
        "preparerName",
        "ownerUid",
        "authorizedUids",
        "createdAt",
        "updatedAt"
      ]
    },
    "StudentProfile": {
      "title": "StudentProfile",
      "description": "Hồ sơ học sinh THPT phục vụ đánh giá thể lực theo Quyết định 53/2008/QĐ-BGDĐT.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "schoolId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentCode": {
          "type": "string",
          "maxLength": 40
        },
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "className": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "gradeLevel": {
          "type": "integer",
          "description": "Khối lớp hoặc năm học (1-5 Tiểu học, 6-9 THCS, 10-12 THPT, 13-16 ĐH/CĐ)"
        },
        "gender": {
          "type": "string",
          "enum": ["nam", "nu"]
        },
        "birthYear": {
          "type": "integer"
        },
        "age": {
          "type": "integer",
          "description": "Độ tuổi đánh giá theo QĐ 53/2008 (6-30 tuổi)"
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        },
        "ownerUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorizedUids": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "schoolId",
        "studentCode",
        "fullName",
        "className",
        "gradeLevel",
        "gender",
        "birthYear",
        "age",
        "notes",
        "ownerUid",
        "authorizedUids",
        "createdAt",
        "updatedAt"
      ]
    },
    "FitnessAssessment": {
      "title": "FitnessAssessment",
      "description": "Kết quả kiểm tra thể lực và chỉ số BMI của học sinh theo từng đợt kiểm tra.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "schoolId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "termLabel": {
          "type": "string",
          "maxLength": 80
        },
        "schoolYear": {
          "type": "string",
          "maxLength": 40
        },
        "testedAt": {
          "type": "string",
          "maxLength": 40
        },
        "ageAtTest": {
          "type": "integer"
        },
        "gender": {
          "type": "string",
          "enum": ["nam", "nu"]
        },
        "heightCm": {
          "type": "number"
        },
        "weightKg": {
          "type": "number"
        },
        "bmi": {
          "type": "number"
        },
        "bmiCategory": {
          "type": "string",
          "maxLength": 40
        },
        "situpsCount": {
          "type": "integer"
        },
        "situpsGrade": {
          "type": "string",
          "enum": ["tot", "dat", "chua_dat"]
        },
        "longJumpCm": {
          "type": "number"
        },
        "longJumpGrade": {
          "type": "string",
          "enum": ["tot", "dat", "chua_dat"]
        },
        "enduranceMode": {
          "type": "string",
          "enum": ["5min_m", "distance_s"]
        },
        "enduranceValue": {
          "type": "number"
        },
        "enduranceGrade": {
          "type": "string",
          "enum": ["tot", "dat", "chua_dat"]
        },
        "overallGrade": {
          "type": "string",
          "enum": ["tot", "dat", "chua_dat"]
        },
        "captureMethod": {
          "type": "string",
          "enum": ["camera_ai", "manual"]
        },
        "status": {
          "type": "string",
          "enum": ["draft", "finalized"]
        },
        "recordedByUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorizedUids": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "studentId",
        "schoolId",
        "termLabel",
        "schoolYear",
        "testedAt",
        "ageAtTest",
        "gender",
        "heightCm",
        "weightKg",
        "bmi",
        "bmiCategory",
        "situpsCount",
        "situpsGrade",
        "longJumpCm",
        "longJumpGrade",
        "enduranceMode",
        "enduranceValue",
        "enduranceGrade",
        "overallGrade",
        "captureMethod",
        "status",
        "recordedByUid",
        "authorizedUids",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserAccount"
      },
      "description": "Thông tin tài khoản, vai trò RBAC và quyền đồng bộ đám mây của người dùng."
    },
    "/user_invites/{inviteId}": {
      "schema": {
        "$ref": "#/entities/UserInvite"
      },
      "description": "Phân quyền cấp trước theo email do Super Admin tạo, sửa, xóa."
    },
    "/schools/{schoolId}": {
      "schema": {
        "$ref": "#/entities/SchoolAdminConfig"
      },
      "description": "Cấu hình hành chính đơn vị, năm học và người lập/ký duyệt báo cáo."
    },
    "/students/{studentId}": {
      "schema": {
        "$ref": "#/entities/StudentProfile"
      },
      "description": "Danh sách hồ sơ học sinh THPT được đồng bộ lên đám mây."
    },
    "/assessments/{assessmentId}": {
      "schema": {
        "$ref": "#/entities/FitnessAssessment"
      },
      "description": "Lịch sử kết quả kiểm tra thể lực và chỉ số BMI qua thời gian."
    }
  }
}
